# ==============================================================================
# BOUKRAA COACHING - NOTIFICATION & CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Target email where Coach receives all client assessment submissions:
NOTIFICATION_EMAIL=coach@boukraa.net

# ------------------------------------------------------------------------------
# OPTION 1 (RECOMMENDED - 100% FREE): RESEND (3,000 emails/month free)
# ------------------------------------------------------------------------------
# 1. Sign up for free at https://resend.com
# 2. Add domain 'boukraa.net' under Domains in Resend & add the 3 DNS records in Spaceship
# 3. Create an API Key in Resend and paste it here:
RESEND_API_KEY=re_your_api_key_here

# Sender address shown in the inbox (verified in Resend):
EMAIL_FROM=BOUKRAA Coaching <notifications@boukraa.net>

# ------------------------------------------------------------------------------
# OPTION 2: HOSTINGER / SPACESHIP SPACEMAIL SMTP (If you already have webmail)
# ------------------------------------------------------------------------------
# SMTP_HOST=mail.spacemail.com        # or smtp.hostinger.com
# SMTP_PORT=465                       # 465 (SSL) or 587 (STARTTLS)
# SMTP_USER=coach@boukraa.net
# SMTP_PASS=your_email_password_here

# ------------------------------------------------------------------------------
# OPTION 3: WEB3FORMS (Zero-config free fallback)
# ------------------------------------------------------------------------------
# WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# ------------------------------------------------------------------------------
# COACH ADMIN DASHBOARD
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=boukraa2026
