{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/admin/submissions/(.*)",
      "destination": "/api/admin/submissions"
    },
    {
      "source": "/api/admin/export",
      "destination": "/api/admin/submissions"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
